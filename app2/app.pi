import os
import xml.etree.ElementTree as ET
import pandas as pd
import gradio as gr

NAMESPACES = {
    'cbc': 'urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2',
    'cac': 'urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2',
    'Invoice': 'urn:oasis:names:specification:ubl:schema:xsd:Invoice-2'
}

def extraer_datos_xml(ruta_archivo):
    try:
        tree = ET.parse(ruta_archivo)
        root = tree.getroot()
        
        cufe_nodo = root.find('cbc:UUID', NAMESPACES)
        cufe = cufe_nodo.text if cufe_nodo is not None else "No encontrado"
        
        num_factura = root.find('cbc:ID', NAMESPACES).text
        fecha_emision = root.find('cbc:IssueDate', NAMESPACES).text
        
        proveedor_nit = root.find('.//cac:AccountingSupplierParty/cac:Party//cbc:CompanyID', NAMESPACES)
        proveedor_nombre = root.find('.//cac:AccountingSupplierParty/cac:Party//cbc:RegistrationName', NAMESPACES)
        
        nit_emisor = proveedor_nit.text if proveedor_nit is not None else "N/A"
        nombre_emisor = proveedor_nombre.text if proveedor_nombre is not None else "N/A"
        
        total_nodo = root.find('.//cac:LegalMonetaryTotal/cbc:PayableAmount', NAMESPACES)
        total_factura = float(total_nodo.text) if total_nodo is not None else 0.0
        
        orden_compra_nodo = root.find('.//cac:OrderReference/cbc:ID', NAMESPACES)
        orden_compra = orden_compra_nodo.text if orden_compra_nodo is not None else "No especificada"
        
        return {
            "Archivo": os.path.basename(ruta_archivo),
            "Factura Nro": num_factura,
            "Fecha Emisión": fecha_emision,
            "NIT Emisor": nit_emisor,
            "Proveedor": nombre_emisor,
            "CUFE": cufe,
            "Valor Total": total_factura,
            "Orden de Compra XML": orden_compra
        }
    except Exception as e:
        return None

def procesar_archivos_web(archivos_subidos):
    if not archivos_subidos:
        return "⚠️ Por favor, sube al menos un archivo XML.", None
        
    lista_facturas = []
    for filepath in archivos_subidos:
        datos = extraer_datos_xml(filepath)
        if datos:
            lista_facturas.append(datos)
            
    if lista_facturas:
        df = pd.DataFrame(lista_facturas)
        
        # Guardar temporalmente el Excel para descarga
        ruta_excel = "reporte_facturas_dian.xlsx"
        df.to_excel(ruta_excel, index=False, engine='openpyxl')
        
        mensaje_exito = f"✅ ¡Proceso completado con éxito! Se procesaron {len(lista_facturas)} facturas."
        return mensaje_exito, ruta_excel
    else:
        return "❌ No se pudo extraer información válida de los archivos XML subidos.", None

# --- DISEÑO DE LA INTERFAZ WEB ---
with gr.Blocks(title="Extractor XML DIAN") as demo:
    gr.Markdown("# 📊 Extractor Automatizado de Facturas DIAN")
    gr.Markdown("Arrastra tus archivos XML diarios aquí abajo y genera tu reporte de Excel en segundos.")
    
    with gr.Row():
        with gr.Column():
            # Componente para arrastrar múltiples archivos XML
            archivos_input = gr.File(file_count="multiple", file_types=[".xml"], label="Sube tus archivos XML aquí")
            btn_procesar = gr.Button("🚀 Procesar Facturas", variant="primary")
        
        with gr.Column():
            # Resultados de salida
            texto_resultado = gr.Textbox(label="Estado del Proceso")
            archivo_excel_salida = gr.File(label="⬇️ Descarga tu archivo de Excel aquí")
            
    btn_procesar.click(
        fn=procesar_archivos_web, 
        inputs=archivos_input, 
        outputs=[texto_resultado, archivo_excel_salida]
    )

if __name__ == "__main__":
    # Lanzar la aplicación web de forma local
    demo.launch(inbrowser=True)
